rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Todo dado do app vive sob users/{uid}: o documento do usuario
    // (aparelho, economia, meta, preferencias) e as subcolecoes
    // records, achievements, crisisSessions e missions.
    // So o proprio dono, autenticado, le e escreve.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
